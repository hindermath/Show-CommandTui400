<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings><LangVersion>14</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>$(LH01BuildRoot)/bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management.Automation"><HintPath>$(LH01PowerShellHome)/System.Management.Automation.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Terminal.Gui" Version="[2.5.0]" />
  </ItemGroup>
</Project>
