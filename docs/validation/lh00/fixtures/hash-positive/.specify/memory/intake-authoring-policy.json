{
  "schemaVersion": "1.1",
  "enabled": true,
  "defaultTargetDirectory": "intakes",
  "receiptDirectory": "specs/intake-authoring-receipts",
  "defaultProfile": "show-commandtui400-de-en",
  "profiles": {
    "show-commandtui400-de-en": ".specify/memory/intake-authoring-profile.md"
  },
  "languagePolicy": "de-DE first; en second; approximately CEFR B2; equivalent content in one intake",
  "defaultDeliveryAuthority": "LocalImplementation",
  "requirementsGovernance": {
    "configPath": "requirements/intake-governance-config.json",
    "schemaVersion": "2.0",
    "migrationJournalDirectory": "requirements/intake-governance-operations",
    "preserveExistingNamesWithoutRenameAuthority": true,
    "requireExactlyOneEligibleCandidate": true
  },
  "maximumQuestionsPerPass": 5,
  "allowExternalSources": true,
  "allowPublicHttpsSources": true,
  "allowSameOriginCrawl": false,
  "urlPolicy": {
    "allowedSchemes": [
      "https"
    ],
    "allowAuthentication": false,
    "allowJavaScript": false,
    "allowCrossOriginCrawl": false,
    "defaultCrawlDepth": 1,
    "defaultMaximumPages": 25,
    "maximumResponseBytes": 2097152,
    "maximumAggregateBytes": 20971520,
    "maximumRedirects": 5
  },
  "seriesDirectory": "specs/intake-authoring-series",
  "operationDirectory": "specs/intake-authoring-operations",
  "archiveDirectory": "specs/intake-authoring-archive",
  "tombstoneDirectory": "specs/intake-authoring-tombstones",
  "requireSeriesProposalApproval": true,
  "deleteMode": "ArchiveAndTombstone",
  "allowOverwrite": false,
  "nextAction": "speckit.intake-review"
}
