      ]
    },
    {
      "name": "Automatic Copilot code review",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "refs/heads/main"
          ]
        }
      },
      "rules": [
        {
          "type": "copilot_code_review",
          "parameters": {
            "review_on_push": false,
            "review_draft_pull_requests": false
          }
        }
      ],
      "bypass_actors": []
    }
